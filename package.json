{
  "name": "ai-dashboard",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "description": "Self-hosted control center for AI projects, coding agents and model research",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test",
    "beta:pc": "node --env-file-if-exists=.env scripts/pc-beta.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opencode-ai/sdk": "1.18.21",
    "octokit": "5.0.5",
    "zod": "4.4.3"
  }
}
